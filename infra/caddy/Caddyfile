{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		# CSP compatible con Google Maps JavaScript API (lista de orígenes oficial de Google).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com https://*.ggpht.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' data: blob: https://*.googleapis.com https://*.google.com https://*.gstatic.com; frame-src https://*.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto http
		}
	}

	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format console
	}
}
