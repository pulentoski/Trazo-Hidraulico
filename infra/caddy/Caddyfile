# Trazo Hidráulico — punto de entrada único.
#
# Local (por defecto): HTTP en :8080, publicado solo en 127.0.0.1.
# Público: SITE_ADDRESS=midominio.cl con infra/compose.public.yml → HTTPS automático (Let's Encrypt).
# Las variables {$...} se reemplazan al leer este archivo; infra/caddy/entrypoint.sh las valida antes.
{
	admin off
	persist_config off
	http_port {$CADDY_HTTP_PORT:8080}
	https_port {$CADDY_HTTPS_PORT:8443}
}

# Basic auth para todo el sitio (protección temporal hasta tener usuarios, etapa 5).
# /healthz queda libre para monitores externos.
(auth_true) {
	@protegido not path /healthz
	basic_auth @protegido {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}
(auth_false) {
}

# Chequeo de salud del contenedor: puerto interno, sin autenticación ni TLS.
http://:8099 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::8080} {
	import auth_{$BASIC_AUTH_ENABLED:true}

	encode zstd gzip

	# Tamaño máximo de las solicitudes: el .inp importado (igual que la API) y el resto de /api.
	@importar path /api/projects/import
	request_body @importar {
		max_size {$MAX_INP_MB:20}MB
	}
	# Ortofotos: límite propio (MAX_ORTHO_MB). Planillas y el resto de /api: 50 MB.
	@ortofotos path_regexp ^/api/projects/[^/]+/orthophotos$
	request_body @ortofotos {
		max_size {$MAX_ORTHO_MB:500}MB
	}
	@api_general {
		path /api/*
		not path /api/projects/import
		not path_regexp ^/api/projects/[^/]+/orthophotos$
	}
	request_body @api_general {
		max_size 50MB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		# CSP compatible con Google Maps JavaScript API (lista de orígenes oficial de Google).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com https://*.ggpht.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' data: blob: https://*.googleapis.com https://*.google.com https://*.gstatic.com; frame-src https://*.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /healthz {
		respond "ok" 200
	}

	# Teselas de ortofotos: el proxy fija el archivo (el cliente solo elige id y tesela).
	@tiles path_regexp tile ^/tiles/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/([0-9]{1,2})/([0-9]{1,8})/([0-9]{1,8})\.png$
	handle @tiles {
		rewrite * /cog/tiles/WebMercatorQuad/{re.tile.2}/{re.tile.3}/{re.tile.4}.png?url=/data/ortho/{re.tile.1}/cog.tif
		reverse_proxy tiler:8000 {
			# Ortofoto inexistente o tesela ilegible: 404 sin detalles internos.
			@fallo status 5xx
			handle_response @fallo {
				respond 404
			}
		}
		header Cache-Control "private, max-age=3600"
	}
	handle /tiles/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto http
		}
	}

	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format console
	}
}
