# ── Trazo Hidráulico · variables de entorno ─────────────────────────────
# Copia este archivo a .env (`make env` lo hace y genera claves aleatorias).

# Puerto local de entrada (solo se publica en 127.0.0.1)
HTTP_PORT=8080

# PostgreSQL + PostGIS
POSTGRES_DB=trazo
POSTGRES_USER=trazo
POSTGRES_PASSWORD=cambia-esta-clave

# Redis
REDIS_PASSWORD=cambia-esta-clave-redis

# Sistema de referencia métrico para calcular largos (UTM 19S por defecto)
LENGTH_SRID=32719

# Centro inicial del mapa y ubicación de redes importadas sin georreferencia
DEFAULT_MAP_CENTER_LAT=-33.4489
DEFAULT_MAP_CENTER_LNG=-70.6693

# Google Maps JavaScript API (opcional). Restringe la key por referente HTTP
# a http://localhost:8080/* . Sin key, el editor funciona con un lienzo neutro.
# Se incorporan al compilar el frontend: tras cambiarlas, ejecuta `make up`.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ── Acceso ─────────────────────────────────────────────────────────────
# La aplicación tiene usuarios propios (make create-admin crea el superadministrador).
SESSION_HOURS=12
# Cookie solo por HTTPS. Déjela en true (http://localhost funciona igual); false SOLO en modo HTTP por IP.
COOKIE_SECURE=true
# Segundo factor (TOTP) obligatorio para administradores de organización y de plataforma.
MFA_REQUIRED_FOR_ADMINS=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_PER_MINUTE=10
# URL pública (enlaces de recuperación e invitación)
PUBLIC_URL=http://localhost:8080
# Correo saliente (opcional). Sin SMTP, el administrador genera enlaces de un solo uso.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Basic auth de Caddy: barrera adicional OPCIONAL (desactivada). Si la activa, defina usuario y hash bcrypt:
#   docker run --rm -it caddy:2.11.9-alpine caddy hash-password   →  BASIC_AUTH_HASH='$2a$14$...'
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Límite de solicitudes a /api por IP y minuto (0 lo desactiva) y tamaño máximo del .inp (MB)
RATE_LIMIT_PER_MINUTE=300
MAX_INP_MB=20

# Publicación (make up-public): dominio cuyo DNS apunta a este servidor (HTTPS automático), o sin dominio:
#   https://IP con TLS_MODE=internal (certificado propio de Caddy: el navegador lo advierte), o
#   http://IP (solo pruebas, sin cifrado; requiere COOKIE_SECURE=false y HSTS_ENABLED=false)
SITE_ADDRESS=
TLS_MODE=auto
HSTS_ENABLED=true

# Respaldo diario en producción (servicio backup de infra/compose.prod.yml)
BACKUP_DIR=/var/backups/trazo-hidraulico
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=14
TZ=America/Santiago

# SIG: tamaño máximo de planillas importadas (MB) y de ortofotos (MB, total de la subida por partes)
MAX_XLSX_MB=20
ORTHO_MAX_MB=2048
# Tamaño máximo de cada parte de la subida en Caddy (la aplicación sube partes de 16 MB)
ORTHO_CHUNK_MB=32
