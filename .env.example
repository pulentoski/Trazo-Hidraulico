# ── Trazo Hidráulico · variables de entorno ─────────────────────────────
# Copia este archivo a .env (`make env` lo hace y genera claves aleatorias).

# Puerto local de entrada (solo se publica en 127.0.0.1)
HTTP_PORT=8080

# PostgreSQL + PostGIS
POSTGRES_DB=trazo
POSTGRES_USER=trazo
POSTGRES_PASSWORD=cambia-esta-clave

# Redis
REDIS_PASSWORD=cambia-esta-clave-redis

# Sistema de referencia métrico para calcular largos (UTM 19S por defecto)
LENGTH_SRID=32719

# Centro inicial del mapa y ubicación de redes importadas sin georreferencia
DEFAULT_MAP_CENTER_LAT=-33.4489
DEFAULT_MAP_CENTER_LNG=-70.6693

# Google Maps JavaScript API (opcional). Restringe la key por referente HTTP
# a http://localhost:8080/* . Sin key, el editor funciona con un lienzo neutro.
# Se incorporan al compilar el frontend: tras cambiarlas, ejecuta `make up`.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ── Acceso (protección temporal hasta tener usuarios) ──────────────────
# Basic auth de Caddy para todo el sitio. Sin usuario y hash el proxy NO arranca.
# Hash bcrypt:  docker run --rm -it caddy:2.11.9-alpine caddy hash-password
# Escriba el hash entre comillas simples (contiene «$»):  BASIC_AUTH_HASH='$2a$14$...'
# En desarrollo local puede desactivarse con BASIC_AUTH_ENABLED=false.
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Límite de solicitudes a /api por IP y minuto (0 lo desactiva) y tamaño máximo del .inp (MB)
RATE_LIMIT_PER_MINUTE=300
MAX_INP_MB=20

# Publicación con HTTPS automático (make up-public): dominio cuyo DNS apunta a este servidor
SITE_ADDRESS=

# SIG: tamaño máximo de planillas importadas (MB) y de ortofotos subidas (MB)
MAX_XLSX_MB=20
MAX_ORTHO_MB=500
