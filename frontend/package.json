{
  "name": "trazo-hidraulico-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen-types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "check": "tsc --noEmit && openapi-typescript src/api/openapi.json -o /tmp/schema.d.ts && diff -u src/api/schema.d.ts /tmp/schema.d.ts && echo 'Tipos generados al día.'"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@vis.gl/react-google-maps": "1.10.2",
    "lucide-react": "1.63.0",
    "maplibre-gl": "6.16.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/google.maps": "3.66.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
